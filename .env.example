# 🌿 PhytoSense v2 Environment Variables

# --- Core Plant Identification ---
# Pl@ntNet API Key (500 free requests/day): https://my.plantnet.org/
PLANTNET_API_KEY=your_plantnet_api_key_here

# Kindwise Plant.id API Key (Emergency tier: 100 free credits): https://www.kindwise.com/
KINDWISE_API_KEY=your_kindwise_api_key_here

# --- LLM Reasoning & Pharmacology Providers (Multi-tier Failover) ---
# Tier 1: Google Gemini (Primary): https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Tier 2: Groq (Ultra-fast inference ~500 tok/s): https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Tier 3: Cerebras (High daily throughput): https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama3.1-70b

# Tier 4: OpenRouter (Open-source free roster): https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Tier 5: Mistral AI (La Plateforme): https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# --- Infrastructure ---
# Redis Connection (Required for cross-process quota and circuit-breaker state in production)
REDIS_URL=redis://localhost:6379/0
